# Database (PostgreSQL lokal)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portofolio_dev

# API Server
API_PORT=3001
WEB_ORIGIN=http://localhost:6001
API_INTERNAL_URL=http://localhost:3001
# Batas ukuran body request untuk @sveltejs/adapter-node (default 512K terlalu kecil untuk upload gambar 5MB / CV 10MB)
BODY_SIZE_LIMIT=20M
# Opsional: kosongkan agar canonical/OG/sitemap otomatis mengikuti origin request (isi di prod jika perlu, mis. https://domainanda.com)
PUBLIC_SITE_URL=
SESSION_SECRET=replace-with-at-least-32-random-chars
# Jumlah proxy tepercaya di depan API (1 = SvelteKit proxy default, 0 = API diakses langsung tanpa proxy)
TRUST_PROXY_HOPS=1
COOKIE_SECURE=false

# Media Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# Opsional saat STORAGE_DRIVER=s3 (Cloudflare R2 / AWS S3 / MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# CLI Admin Seed (hanya dipakai saat menjalankan pnpm db:seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
